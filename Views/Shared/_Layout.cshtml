<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodOrderShop</title>

    <!-- Bootstrap 5 & FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f8f9fa;
            }
            .navbar-custom {
                background: linear-gradient(135deg, #ff4e50, #f9d423);
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            }
            .navbar-brand, .nav-link {
                color: #fff !important;
                font-weight: 600;
            }
            .nav-link:hover {
                opacity: 0.8;
            }
            .footer-custom {
                background-color: #1a1a1a;
                color: #ccc;
                padding: 20px 0;
                margin-top: 50px;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand fs-3" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-utensils me-2"></i>Foodies
                </a>
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-controller="Home" asp-action="Index" asp-fragment="categories">
                                <i class="bi bi-list-stars"></i> Categories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-controller="Admin" asp-action="Orders">
                                ⚙️ Admin Panel
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        @RenderBody()
    </div>

    <!-- Bootstrap Icons CDN ( ensure inside <head> tag of _Layout.cshtml if icons don't show ) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Stylish Footer -->
    <footer class="bg-dark text-white pt-5 pb-4 mt-5">
        <div class="container text-center text-md-start">
            <div class="row text-center text-md-start">

                <!-- About -->
                <div class="col-md-4 col-lg-4 col-xl-4 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-warning">🍕 Foodies</h5>
                    <p class="text-white-50">Delicious food delivered fast to your door. Fresh ingredients, top quality, and amazing tastes guaranteed everyday.</p>
                </div>

                <!-- Quick Links -->
                <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-warning">Quick Links</h5>
                    <p><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Home</a></p>
                    <p><a asp-controller="Home" asp-action="Index" asp-fragment="menu" class="text-white-50 text-decoration-none">Menu</a></p>
                    <p><a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none">Contact Us</a></p>
                </div>

                <!-- Contact Info -->
                <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-warning">Contact</h5>
                    <p class="text-white-50"><i class="bi bi-house-door me-2"></i> ECB Chattor, Mirpur, Dhaka</p>
                    <p class="text-white-50"><i class="bi bi-envelope me-2"></i> bakaul15-4163@diu.edu.bd</p>
                    <p class="text-white-50"><i class="bi bi-phone me-2"></i> +880 1793-097400</p>
                </div>

                <!-- Social Links -->
                <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3 text-center text-md-start">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-warning">Follow Us</h5>
                    <div class="d-flex gap-3 justify-content-center justify-content-md-start">
                        <a href="https://facebook.com" target="_blank" class="btn btn-outline-light rounded-circle"><i class="bi bi-facebook"></i></a>
                        <a href="https://instagram.com" target="_blank" class="btn btn-outline-light rounded-circle"><i class="bi bi-instagram"></i></a>
                        <a href="https://twitter.com" target="_blank" class="btn btn-outline-light rounded-circle"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://youtube.com" target="_blank" class="btn btn-outline-light rounded-circle"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

            </div>

            <hr class="mb-4 mt-4 border-secondary">

            <div class="row align-items-center">
                <div class="col-md-12 text-center">
                    <p class="text-white-50 mb-0">© 2026 <strong>Foodies Restaurant</strong>. All Rights Reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>