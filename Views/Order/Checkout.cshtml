@model FoodOrderShop.Models.Order

@{
    ViewData["Title"] = "Checkout";
    var cart = ViewBag.Cart as List<FoodOrderShop.Models.CartItem>;
}

<div class="container my-5">
    <h2 class="fw-bold mb-4">🚚 Checkout & Shipping</h2>

    <div class="row g-4">
        <!-- Shipping Form -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 p-4 rounded-3">
                <h4 class="fw-bold mb-3">Delivery Information</h4>
                <form asp-action="PlaceOrder" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter your full name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="017xxxxxxxx" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Address</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Road no, House no, Area" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-gradient text-white w-100 py-2 fw-bold fs-5 mt-3" style="background: linear-gradient(135deg, #ff4e50, #f9d423);">
                        Confirm Order (Cash on Delivery)
                    </button>
                </form>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 p-4 rounded-3 bg-light">
                <h4 class="fw-bold mb-3">Your Items</h4>
                @if (cart != null)
                {
                    @foreach (var item in cart)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="fw-bold">@item.FoodName</span>
                                <small class="text-muted d-block">Qty: @item.Quantity × ৳@item.Price</small>
                            </div>
                            <span class="fw-bold">৳@item.Total</span>
                        </div>
                    }
                }
                <hr>
                <div class="d-flex justify-content-between mb-1">
                    <span>Subtotal</span>
                    <span>৳@ViewBag.Subtotal</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span>Delivery Charge</span>
                    <span>৳@ViewBag.DeliveryFee</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between fw-bold fs-5 text-success">
                    <span>Total Pay</span>
                    <span>৳@ViewBag.GrandTotal</span>
                </div>
            </div>
        </div>
    </div>
</div>