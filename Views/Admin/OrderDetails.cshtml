@model FoodOrderShop.Models.Order

@{
    ViewData["Title"] = "Order Details #" + Model.Id;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📝 Order Details (#@Model.Id)</h2>
        <a asp-action="Orders" class="btn btn-outline-secondary">← Back to Orders</a>
    </div>

    <div class="row g-4">
        <!-- Customer Info & Status Update -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 p-4 rounded-3 bg-light">
                <h4 class="fw-bold mb-3">Customer Information</h4>
                <p><strong>Name:</strong> @Model.FullName</p>
                <p><strong>Phone:</strong> @Model.PhoneNumber</p>
                <p><strong>Address:</strong> @Model.Address</p>
                <p><strong>Order Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                <hr />

                <!-- Status Change Form -->
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <label class="form-label fw-bold">Update Order Status:</label>
                    <div class="input-group">
                        <select name="status" class="form-select">
                            <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Pending</option>
                            <option value="Processing" selected="@(Model.OrderStatus == "Processing")">Processing</option>
                            <option value="Delivered" selected="@(Model.OrderStatus == "Delivered")">Delivered</option>
                            <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Cancelled</option>
                        </select>
                        <button type="submit" class="btn btn-success">Update</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Ordered Food Items List -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 p-4 rounded-3">
                <h4 class="fw-bold mb-3">Items Ordered</h4>
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>@item.FoodItem?.Name</td>
                                <td>৳@item.UnitPrice</td>
                                <td>@item.Quantity</td>
                                <td class="fw-bold">৳@(item.UnitPrice * item.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-bold text-success">
                    <span>Grand Total (Inc. Delivery):</span>
                    <span>৳@Model.TotalAmount</span>
                </div>
            </div>
        </div>
    </div>
</div>