@model IEnumerable<FoodOrderShop.Models.FoodItem>

@{
    ViewData["Title"] = "Home Page";
    var categories = ViewBag.Categories as IEnumerable<FoodOrderShop.Models.Category>;
    int? selectedCategory = ViewBag.SelectedCategory as int?;
}

<style>
    /* Hero Section Gradient & Parallax Effect */
    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=1200') center/cover no-repeat;
        color: white;
        padding: 90px 0;
        border-radius: 0 0 30px 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    /* Card Hover Animations & Shadows */
    .food-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.3s ease;
        background: #fff;
    }

        .food-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.12) !important;
        }

    .btn-gradient {
        background: linear-gradient(135deg, #ff4e50, #f9d423);
        color: white;
        border: none;
        font-weight: 600;
        border-radius: 25px;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(135deg, #f9d423, #ff4e50);
            color: white;
            transform: scale(1.02);
        }

    .category-btn {
        border-radius: 25px;
        padding: 8px 24px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    /* Feature Cards Design */
    .feature-card {
        border-radius: 20px;
        transition: all 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
        }

    /* Testimonial Card Design */
    .review-card {
        border-radius: 20px;
        background: #f8f9fa;
        border: 1px solid #eee;
    }
</style>

<!-- Hero Section -->
<div class="hero-section text-center mb-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">Delicious Food Delivered To You</h1>
        <p class="lead mb-4 fs-4 opacity-90">Choose from your favorite dishes and order instantly with high quality & speed.</p>
        <a href="#menu" class="btn btn-gradient btn-lg px-5 py-3 shadow">Explore Menu 🍕</a>
    </div>
</div>

<div class="container my-5" id="menu">
    <div class="text-center mb-4">
        <span class="badge bg-danger text-uppercase px-3 py-2 rounded-pill">Tasty & Fresh</span>
        <h2 class="fw-bold display-6 mt-2">Our Special Food Menu</h2>
    </div>

    <!-- Category Filter System -->
    <div class="d-flex justify-content-center flex-wrap gap-2 mb-5">
        <a asp-action="Index" class="btn category-btn @(selectedCategory == null ? "btn-dark shadow" : "btn-outline-dark")">
            All Items
        </a>
        @if (categories != null)
        {
            @foreach (var cat in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@cat.Id"
                   class="btn category-btn @(selectedCategory == cat.Id ? "btn-dark shadow" : "btn-outline-dark")">
                    @cat.CategoryName
                </a>
            }
        }
    </div>

    <!-- Dynamic Food Items Grid -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="text-center my-5 py-5">
                <div class="fs-1 text-muted">🍽️</div>
                <h4 class="text-muted mt-3">No food items found in this category!</h4>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card food-card h-100 shadow-sm">
                        <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" alt="@item.Name">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title fw-bold mb-0 fs-6 text-dark">@item.Name</h5>
                                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">৳@item.Price</span>
                            </div>
                            <p class="card-text text-muted flex-grow-1 small">@item.Description</p>

                            <!-- Add to Cart Button -->
                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-foodId="@item.Id" class="btn btn-gradient w-100 mt-3 py-2 text-center text-decoration-none shadow-sm">
                                Add to Cart 🛒
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- 1. Special Offer Banner Section -->
    <div class="my-5 pt-4">
        <div class="p-5 rounded-4 text-white text-center shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #ff416c, #ff4b2b);">
            <div class="py-3">
                <span class="badge bg-white text-danger fw-bold px-3 py-2 rounded-pill mb-3 text-uppercase">Limited Time Offer</span>
                <h2 class="fw-bold display-5 mb-3">🔥 Get 20% OFF Your First Order!</h2>
                <p class="fs-5 mb-4">Use promo code <span class="badge bg-dark text-warning px-3 py-2 fs-6">FOODIE20</span> at checkout page.</p>
                <a href="#menu" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-danger shadow">Order Now</a>
            </div>
        </div>
    </div>

    <!-- 2. Why Choose Us Section -->
    <div class="my-5 py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-6">Why Choose Foodies?</h2>
            <p class="text-muted">We serve the best food with top-class quality and fast delivery services.</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="card feature-card h-100 border-0 shadow-sm p-4 bg-white">
                    <div class="fs-1 text-danger mb-3">⚡</div>
                    <h4 class="fw-bold mb-2">Super Fast Delivery</h4>
                    <p class="text-muted mb-0">Hot and fresh food delivered directly to your doorstep within 30 minutes.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100 border-0 shadow-sm p-4 bg-white">
                    <div class="fs-1 text-warning mb-3">🍔</div>
                    <h4 class="fw-bold mb-2">100% Fresh & Hygienic</h4>
                    <p class="text-muted mb-0">Prepared with organic & fresh ingredients by world-class professional chefs.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100 border-0 shadow-sm p-4 bg-white">
                    <div class="fs-1 text-success mb-3">💳</div>
                    <h4 class="fw-bold mb-2">Easy & Flexible Payment</h4>
                    <p class="text-muted mb-0">Enjoy seamless Cash on Delivery or fast online payment gateways.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Customer Testimonials Section -->
    <div class="my-5 py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-6">What Our Customers Say</h2>
            <p class="text-muted">Read genuine reviews from food lovers in your city.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card review-card p-4 shadow-sm h-100">
                    <div class="text-warning mb-2">⭐⭐⭐⭐⭐</div>
                    <p class="text-muted italic">"The burger was super juicy and delivered hot! Best food service in Mirpur area."</p>
                    <h6 class="fw-bold mb-0 mt-3">— Tanvir Ahmed</h6>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card review-card p-4 shadow-sm h-100">
                    <div class="text-warning mb-2">⭐⭐⭐⭐⭐</div>
                    <p class="text-muted italic">"Very easy ordering system and super quick delivery. Highly recommended!"</p>
                    <h6 class="fw-bold mb-0 mt-3">— Sadia Rahman</h6>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card review-card p-4 shadow-sm h-100">
                    <div class="text-warning mb-2">⭐⭐⭐⭐⭐</div>
                    <p class="text-muted italic">"Pizza quality was top notch. Packing and delivery speed were impressingly good."</p>
                    <h6 class="fw-bold mb-0 mt-3">— Rahim Chowdhury</h6>
                </div>
            </div>
        </div>
    </div>
</div>