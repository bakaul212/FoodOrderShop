@model IEnumerable<FoodOrderShop.Models.Order>

@{
    ViewData["Title"] = "Admin - Manage Orders";
}

<div class="container my-5">
    <h2 class="fw-bold mb-4">📦 Order Management Panel</h2>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Total Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@item.Id</td>
                            <td>@item.FullName</td>
                            <td>@item.PhoneNumber</td>
                            <td class="fw-bold text-success">৳@item.TotalAmount</td>
                            <td>@item.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                @if (item.OrderStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (item.OrderStatus == "Delivered")
                                {
                                    <span class="badge bg-success">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@item.OrderStatus</span>
                                }
                            </td>
                            <td>
                                <a asp-action="OrderDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">View Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>