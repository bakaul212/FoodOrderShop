@model FoodOrderShop.Models.Order

@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container my-5 text-center">
    <div class="card shadow-sm border-0 p-5 rounded-3 mx-auto" style="max-width: 600px;">
        <div class="mb-3 text-success">
            <h1 class="display-1">🎉</h1>
        </div>
        <h2 class="fw-bold text-success mb-2">Thank You For Your Order!</h2>
        <p class="text-muted mb-4">Your order has been placed successfully. Cash on Delivery on arrival.</p>

        <div class="bg-light p-3 rounded-3 text-start mb-4">
            <p class="mb-1"><strong>Order ID:</strong> #@Model.Id</p>
            <p class="mb-1"><strong>Name:</strong> @Model.FullName</p>
            <p class="mb-1"><strong>Phone:</strong> @Model.PhoneNumber</p>
            <p class="mb-1"><strong>Delivery Address:</strong> @Model.Address</p>
            <p class="mb-0 fw-bold text-success"><strong>Total Amount:</strong> ৳@Model.TotalAmount</p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">Back to Home</a>
    </div>
</div>