@{
    ViewData["Title"] = "Contact Us";
}

<style>
    /* Premium Contact Hero Banner */
    .contact-hero {
        background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=1200') center/cover no-repeat;
        color: white;
        padding: 70px 0;
        border-radius: 0 0 30px 30px;
    }

    .contact-card {
        border-radius: 20px;
        transition: all 0.3s ease;
    }

    .info-icon-box {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 78, 80, 0.1);
        color: #ff4e50;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .btn-gradient-contact {
        background: linear-gradient(135deg, #ff4e50, #f9d423);
        color: white;
        border: none;
        font-weight: 600;
        border-radius: 30px;
        transition: all 0.3s ease;
    }

        .btn-gradient-contact:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 78, 80, 0.3);
            color: white;
        }
</style>

<!-- Top Hero Header -->
<div class="contact-hero text-center mb-5">
    <div class="container">
        <span class="badge bg-danger text-uppercase px-3 py-2 rounded-pill mb-2">We Are Here For You</span>
        <h1 class="display-4 fw-bold mb-2">Get In Touch With Us</h1>
        <p class="lead mb-0 text-white-50">Have a question, feedback, or need help with your order?</p>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4 mb-5">
        <!-- Contact Information Cards -->
        <div class="col-lg-5">
            <div class="card contact-card border-0 shadow-sm p-4 bg-white h-100">
                <h3 class="fw-bold mb-4 text-dark">Contact Information</h3>

                <div class="d-flex align-items-center mb-4">
                    <div class="info-icon-box me-3">📍</div>
                    <div>
                        <h6 class="fw-bold mb-0 text-muted">Our Location</h6>
                        <p class="fw-bold text-dark mb-0">ECB Chattor, Mirpur, Dhaka, Bangladesh</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="info-icon-box me-3">📞</div>
                    <div>
                        <h6 class="fw-bold mb-0 text-muted">Phone Number</h6>
                        <p class="fw-bold text-dark mb-0">+880 1793-097400</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="info-icon-box me-3">✉️</div>
                    <div>
                        <h6 class="fw-bold mb-0 text-muted">Email Address</h6>
                        <p class="fw-bold text-dark mb-0">bakaul15-4163@diu.edu.bd</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-2">
                    <div class="info-icon-box me-3">⏰</div>
                    <div>
                        <h6 class="fw-bold mb-0 text-muted">Opening Hours</h6>
                        <p class="fw-bold text-dark mb-0">Everyday: 10:00 AM - 11:00 PM</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card contact-card border-0 shadow-sm p-4 p-md-5 bg-white">
                <h3 class="fw-bold mb-2 text-dark">Send Us A Message</h3>
                <p class="text-muted mb-4">Fill out the form below and our team will get back to you shortly.</p>

                <form>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">YOUR NAME</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" placeholder="John Doe" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">EMAIL ADDRESS</label>
                            <input type="email" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" placeholder="name@example.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">SUBJECT</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" placeholder="Order Inquiry / Feedback" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">MESSAGE</label>
                            <textarea class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" rows="4" placeholder="Write your message here..." required></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="button" onclick="alert('Thank you! Your message has been sent successfully.')" class="btn btn-gradient-contact btn-lg w-100 py-3 fs-6">
                                Send Message 🚀
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Google Map Integration -->
    <div class="row">
        <div class="col-12">
            <div class="card contact-card border-0 shadow-sm overflow-hidden" style="height: 350px;">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3650.09811440733!2d90.38799437603683!3d23.815086885601246!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755c6c80a6b5a37%3A0xe7261a86ff3b9e59!2sECB%20Chattar!5e0!3m2!1sen!2sbd!4v1700000000000!5m2!1sen!2sbd"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</div>